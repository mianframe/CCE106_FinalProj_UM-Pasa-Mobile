{
  "expo": {
    "name": "UM-Pasa",
    "slug": "um-pasa-expo-standalone",
    "version": "1.0.0",
    "scheme": "umpasa",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/UMPASALOGO.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.edu.umindanao.umpasa",
      "buildNumber": "1"
    },
    "android": {
      "package": "ph.edu.umindanao.umpasa",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/UMPASALOGO.png",
        "backgroundColor": "#121214"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121214",
          "image": "./assets/UMPASALOGO.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow UM-Pasa to access your photos to upload item images and payment proofs."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
